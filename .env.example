# Personal Vault settings.
# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds a secret and is ignored by git. Never commit it.

# Required. Signs the login cookie. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start while this is still the example value.
SESSION_SECRET=replace-me-with-the-output-of-the-command-above

# Largest single upload, in MB. 2048 = 2 GB.
MAX_UPLOAD_SIZE_MB=2048

# Set to true once you only open the vault at its https://....ts.net address (stage S3).
VAULT_COOKIE_SECURE=false

# That https://....ts.net address, so changes made from it are accepted. Comma-separated.
# Example: VAULT_ALLOWED_ORIGINS=https://office-vault.tail1234.ts.net
VAULT_ALLOWED_ORIGINS=

# How long you stay logged in on a device, in days.
SESSION_DAYS=30

# How many database snapshots the backup keeps.
BACKUP_KEEP=30

# Used only to show dates and times. Stored times are always UTC.
VAULT_TIMEZONE=Asia/Kolkata

# Only when running without Docker. Docker always uses ./data and ./backups.
# VAULT_DATA_DIR=./data
# VAULT_BACKUP_DIR=./backups
